          "operationName": "SQL OrganizationAccount Pluck",
          "references": [
            {
              "refType": "CHILD_OF",
              "traceID": "b7e5891467b647a8a5c2eec2df9acccd",
              "spanID": "3bfbd9795e82f3d3"
            }
          ],
          "startTime": 1789613628442509,
          "duration": 479,
          "tags": [
            {
              "key": "otel.scope.name",
              "type": "string",
              "value": "iam.application_sql"
            },
            {
              "key": "db.name",
              "type": "string",
              "value": "organization-db_test"
            },
            {
              "key": "db.query.name",
              "type": "string",
              "value": "OrganizationAccount Pluck"
            },
            {
              "key": "db.statement",
              "type": "string",
              "value": "SELECT \"organization_accounts\".\"account_id\", \"managed\".\"msp_account_id\", \"managed\".\"msp_organization_id\", \"managed\".\"client_organization_id\" FROM \"organization_accounts\" INNER JOIN msp_managed_organizations managed ON managed.client_organization_id = organization_accounts.organization_id INNER JOIN organization_accounts provider ON provider.account_id = managed.msp_account_id AND provider.organization_id = managed.msp_organization_id WHERE \"organization_accounts\".\"account_id\" = 'a1710000-0000-4000-8000-7d10de8554ed' /*action='providers',application='OrganizationService',controller='account_contexts'*/"
            },
            {
              "key": "db.system",
              "type": "string",
              "value": "postgresql"
            },
            {
              "key": "span.kind",
              "type": "string",
              "value": "client"
            }
          ],
