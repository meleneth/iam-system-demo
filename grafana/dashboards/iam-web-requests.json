{
  "id": null,
  "uid": "iam-web-requests",
  "title": "IAM \u00b7 Web Requests",
  "description": "Inbound HTTP requests from existing OpenTelemetry traces. Health checks and /metrics are excluded. UUIDs/numeric path IDs are normalized; query strings are removed. Blank panels mean no observed traffic, not proof that a service is down. Each internal service request is counted at its receiving service. Expand the service rows for route details.",
  "tags": [
    "iam-demo",
    "observability"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Web requests",
      "type": "link",
      "url": "/d/iam-web-requests",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/iam-postgresql",
      "keepTime": true
    },
    {
      "title": "Redis",
      "type": "link",
      "url": "/d/iam-redis",
      "keepTime": true
    },
    {
      "title": "Application cache hits",
      "type": "link",
      "url": "/d/iam-demo-cache-hit-miss",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Web service",
        "type": "custom",
        "query": "user-management-service,user-service,account-service,organization-service,group-service,authorization-service,account-auth-service,organization-auth-service,group-auth-service",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "user-management-service",
            "value": "user-management-service",
            "selected": false
          },
          {
            "text": "user-service",
            "value": "user-service",
            "selected": false
          },
          {
            "text": "account-service",
            "value": "account-service",
            "selected": false
          },
          {
            "text": "organization-service",
            "value": "organization-service",
            "selected": false
          },
          {
            "text": "group-service",
            "value": "group-service",
            "selected": false
          },
          {
            "text": "authorization-service",
            "value": "authorization-service",
            "selected": false
          },
          {
            "text": "account-auth-service",
            "value": "account-auth-service",
            "selected": false
          },
          {
            "text": "organization-auth-service",
            "value": "organization-auth-service",
            "selected": false
          },
          {
            "text": "group-auth-service",
            "value": "group-auth-service",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(iam_http_calls_total{service_name=~\"${service:regex}\",http_route!~\"/metrics|/up\"}[$__rate_interval]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "title": "Requests in selected period",
      "description": "Estimated from counter increases; newly observed series need a baseline scrape.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(increase(iam_http_calls_total{service_name=~\"${service:regex}\",http_route!~\"/metrics|/up\"}[$__range]))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "P95 response time",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iam_http_duration_seconds_bucket{service_name=~\"${service:regex}\",http_route!~\"/metrics|/up\"}[$__rate_interval])))",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
