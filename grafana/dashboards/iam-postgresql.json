{
  "id": null,
  "uid": "iam-postgresql",
  "title": "IAM \u00b7 PostgreSQL",
  "description": "Production PostgreSQL telemetry for all 20 primary, cache, cable, and queue containers. Collects database statistics every 10 seconds. Counts include monitoring activity. Missing metrics expire after 30 seconds; reporting counts describe telemetry coverage, not a database availability probe. Expand a database row for detail.",
  "tags": [
    "iam-demo",
    "observability"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Web requests",
      "type": "link",
      "url": "/d/iam-web-requests",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/iam-postgresql",
      "keepTime": true
    },
    {
      "title": "Redis",
      "type": "link",
      "url": "/d/iam-redis",
      "keepTime": true
    },
    {
      "title": "Application cache hits",
      "type": "link",
      "url": "/d/iam-demo-cache-hit-miss",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
