{
  "id": null,
  "uid": "iam-redis",
  "title": "IAM \u00b7 Redis",
  "description": "Production Redis INFO and command statistics for accountcache, authcache, orgcache, and groupcache. Redis server hit ratios differ from application cache hit/miss counters; both dashboards are linked above. Metrics collect every 10 seconds and expire after 30 seconds without updates. Expand an instance row for detail.",
  "tags": [
    "iam-demo",
    "observability"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Web requests",
      "type": "link",
      "url": "/d/iam-web-requests",
      "keepTime": true
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/iam-postgresql",
      "keepTime": true
    },
    {
      "title": "Redis",
      "type": "link",
      "url": "/d/iam-redis",
      "keepTime": true
    },
    {
      "title": "Application cache hits",
      "type": "link",
      "url": "/d/iam-demo-cache-hit-miss",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "redis",
        "label": "Redis instance",
        "type": "custom",
        "query": "accountcache,authcache,orgcache,groupcache",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "accountcache",
            "value": "accountcache",
            "selected": false
          },
          {
            "text": "authcache",
            "value": "authcache",
            "selected": false
          },
          {
            "text": "orgcache",
            "value": "orgcache",
            "selected": false
          },
          {
            "text": "groupcache",
            "value": "groupcache",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Instances reporting \u00b7 4 total",
      "description": "Count among selected instances. All selected should report four; this measures telemetry coverage.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "count(redis_memory_used_bytes{server_address=~\"${redis:regex}\"})",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
