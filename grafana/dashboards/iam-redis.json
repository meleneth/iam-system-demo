    {
      "id": 7,
      "title": "Redis keyspace hit ratio",
      "description": "Redis key lookups only. No ratio is shown until lookups occur.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum by (server_address) (rate(redis_keyspace_hits_total{server_address=~\"${redis:regex}\"}[$__rate_interval])) / (sum by (server_address) (rate(redis_keyspace_hits_total{server_address=~\"${redis:regex}\"}[$__rate_interval])) + sum by (server_address) (rate(redis_keyspace_misses_total{server_address=~\"${redis:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{server_address}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
